<div id="body-wrapper">
  <div id="skip-content"><a class="Skip-btn" href="#skipToContent">Skip To Main Content</a></div>
  <!-- Header Section -->
  <header id="header" class="main-header sticky-header">
    {{ render '@global-header' }}
    {{ render '@site-navigation' }}
  </header>
  <!-- Header Section End -->
  <!-- Main Content Body -->
  <main>
    <!--Slider -->
    <section class="slider-wrapper" id="main-slider-wrapper">
      {{> @banner--slim}}
      {{> @breadcrumb }}
    </section>
    <!-- End Slider -->
    <section class="event-description-sec" id="skipToContent">
      <div class="container">
        <div class="row">
          <div class="col-xxl-6 col-xl-6 col-lg-6 col-md-6 col-sm-12">
            <div class="event-description-img">
              <img src="{{path '/college-dls/college/images/events-des.png'}}" alt="Event Description">
            </div>
            <div class="event-des-left">
              <h2 class="h5">Description</h2>
              <p>Maecenas tincidunt urna a porta lobortis. Aliquam sit amet eros quam. Fusce venenatis ipsum non est
                porta porttitor. Curabitur aliquet mattis elit. Mauris eget velit bibendum, auctor risus eu, elementum
                sem. Fusce magna neque, bibendum in efficitur ut, elementum non risus. </p>
                <ul>
                  <li>Lorem ipsum dolor sit amet consectetur adipisicing elit. Illo exercitationem pariatur sapiente earum possimus suscipit labore quo tempore eos explicabo, quis quia cumque ad vitae. Repudiandae aspernatur sapiente cupiditate vitae.</li>
                  <li>Odit eveniet sapiente placeat cum impedit molestiae provident veniam delectus quas! Maxime ut a nam qui reiciendis, libero eum corrupti sunt minus expedita laboriosam, ullam laudantium tempore quis ratione placeat.</li>
                  <li>Explicabo atque cupiditate reiciendis fugiat nulla illum laudantium adipisci placeat ad architecto maxime, consequatur, totam nesciunt voluptates esse sed at eveniet laborum cum nostrum voluptatibus! Voluptate nulla aliquam quam perspiciatis.</li>
                </ul>
            </div>
          </div>
          <div class="col-xxl-6 col-xl-6 col-lg-6 col-md-6 col-sm-12">
            <div class="event-description-content">
              <h3>Lorem ipsum dolor sit amet, consectetur adipiscing elit</h3>
              <div class="event-des-list">
                <div class="row">
                  <div class="col-xxl-2 col-xl-2 col-lg-2 col-md-2 col-sm-12">
                    <div class="left-icon">
                      <i class="fas fa-calendar-week" aria-hidden="true"></i>
                    </div>
                  </div>
                  <div class="col-xl-10 col-lg-10 col-md-10 col-sm-12">
                    <div class="event-info">
                      <h3 class="h5">Date &amp; Time</h3>
                      <h4 class="h6"><span class="starting-time">Friday, February 19 2021 at 1:00 PM CST</span> to
                        <span class="end-time">Friday, February 19 2021 at 2:00 PM CST </span>
                      </h4>
                      <p><a href="">Add To Google Calendar</a> | <a href="">iCal/Outlook</a></p>
                    </div>
                  </div>
                </div>
                <div class="row">
                  <div class="col-xxl-2 col-xl-2 col-lg-2 col-md-2 col-sm-12">
                    <div class="left-icon">
                      <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
                    </div>
                  </div>
                  <div class="col-xl-10 col-lg-10 col-md-10 col-sm-12">
                    <div class="event-info">
                      <h3 class="h5">Location</h3>
                      <p>Online</p>
                    </div>
                  </div>
                </div>
                <div class="row">
                  <div class="col-xxl-2 col-xl-2 col-lg-2 col-md-2 col-sm-12">
                    <div class="left-icon">
                      <i class="fas fa-laptop" aria-hidden="true"></i>
                    </div>
                  </div>
                  <div class="col-xl-10 col-lg-10 col-md-10 col-sm-12">
                    <div class="event-info">
                      <h3 class="h5">Online Location</h3>
                      <p>Join Event Online</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {{ render '@event-group'}}

    {{ render '@event-list'}}

    {{ render '@event-list--image'}}

    <!-- ENROLLMENT CTA -->
    {{ render '@enrollment-call-to-action' }}
    <!-- END CTA -->
  </main>
  {{ render '@back-to-top' }}  
  <!-- End Main Content Body -->
  {{ render '@global-footer' }}
</div>